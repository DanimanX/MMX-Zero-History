# Generated recompiler output — ROM-derived, never committed.
/src/gen/*
!/src/gen/.gitkeep
/recomp/funcs.h

# ROM images and anything derived from them.
*.sfc
*.smc
*.srm
/saves/

# Cx4 internal data ROM (HG51B S169 reciprocal/sqrt/trig table). Capcom/Hitachi
# firmware, user-supplied, 3072 bytes. All three names are the same blob.
cx4.rom
cx4.data.rom
hg51bs169.data.rom

# Build trees
/build*/
/release*/
/CMakeFiles/
CMakeCache.txt

# Local runtime state
/rom.cfg
/config.ini
/*.log
/_*.log
/_*.png
/_*.bmp
/host_report*.json
/*.dmp
/tools/__pycache__/
/_diz_baseline_cfg/

# Shared desktop host local preferences and reports
/config.local.ini
/keybinds.ini
/tier2_*.json

# Zero History — Android build output and user-supplied assets
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/app/src/main/jniLibs/
/android/app/src/main/assets/*.sfc
/android/app/src/main/assets/*.smc
/build-android*/
/dist/

# Soundtrack render scratch (the committed artifacts are the .ogg files)
*.wav

# SDL3 Java surface, staged by tools/build_android.sh (third-party, not ours)
/android/app/src/main/java/org/libsdl/

# Mod catalog staged into the APK assets by tools/build_android.sh
/android/app/src/main/assets/mods/
